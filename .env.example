# Copia este archivo a .env.local y completa los valores reales.
# .env.local está en .gitignore — nunca subas credenciales al repo.

# Conexión a PostgreSQL (BD `nuvio`). Dev local: contenedor Docker en :5470.
DATABASE_URL="postgresql://nuvio:CONTRASENA@localhost:5470/nuvio"

# URL pública de la app (se usa en enlaces absolutos y metadata).
APP_URL="http://localhost:3000"

# Clave AES-256-GCM (32 bytes en base64) para cifrar secretos en reposo
# (contraseña de la llave privada del CSD por empresa). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reusar la misma clave entre entornos (dev/staging/prod).
CSD_ENCRYPTION_KEY="GENERA_UNA_CLAVE_PROPIA"

# Credenciales de la cuenta Finkok de Nuvio (una sola cuenta para todos los
# tenants; el CSD sí es por empresa, esto es la cuenta del PAC).
FINKOK_SANDBOX_USER="CONTRASENA"
FINKOK_SANDBOX_PASSWORD="CONTRASENA"
FINKOK_PROD_USER="CONTRASENA"
FINKOK_PROD_PASSWORD="CONTRASENA"

# Correo saliente (SparkPost) — transversal a todos los módulos, no solo Facturación.
SPARKPOST_API_KEY="CONTRASENA"
SPARKPOST_API_BASE="https://api.sparkpost.com/api/v1"
EMAIL_FROM="no-responder@tu-dominio.com"
EMAIL_FROM_NAME="Nuvio"

# SMS saliente (LabsMobile) — transversal, aún sin caso de uso construido.
LABSMOBILE_USERNAME="CONTRASENA"
LABSMOBILE_API_TOKEN="CONTRASENA"
LABSMOBILE_SENDER="CONTRASENA"
LABSMOBILE_API_BASE="https://api.labsmobile.com/json/send"
